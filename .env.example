# By default the app reads OpenAI settings from ../tools/.env, like Revision.
# Only set this if Tools is stored somewhere else:
# OPENAI_ENV_FILE=/home/hammonja/tools/.env
# Optional local overrides (never commit your .env):
# OPENAI_API_KEY=
GOLF_AI_MODEL=gpt-6-sol
GOLF_AI_ENABLED=1
# API request budget per rolling 24 hours. Each attempt reserves 2 requests
# (draft + factual edit), including failures. Minimum effective budget: 2.
GOLF_AI_DAILY_LIMIT=24
